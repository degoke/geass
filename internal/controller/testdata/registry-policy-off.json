      "spec": {
        "backoffLimit": 2,
        "template": {
          "metadata": {},
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "--dockerfile=/workspace/Dockerfile",
                  "--context=dir:///workspace",
                  "--destination=registry.example/acme/api:1",
                  "--digest-file=/dev/termination-log"
                ],
                "image": "gcr.io/kaniko-project/executor:v1.23.2",
                "name": "kaniko",
                "resources": {},
                "terminationMessagePath": "/dev/termination-log",
                "volumeMounts": [
                  {
                    "mountPath": "/workspace",
                    "name": "workspace"
                  },
                  {
                    "mountPath": "/kaniko/.docker",
                    "name": "registry-auth",
                    "readOnly": true
                  }
                ]
              }
            ],
            "initContainers": [
              {
                "command": [
                  "sh",
                  "-c",
                  "git -c http.extraheader=\"Authorization: Bearer $GITHUB_TOKEN\" clone --branch \"$BRANCH\" https://github.com/ /workspace \u0026\u0026 git -C /workspace checkout --detach \"$REVISION\""
                ],
                "env": [
                  {
                    "name": "BRANCH",
                    "value": "main"
                  },
                  {
                    "name": "REVISION",
                    "value": "main"
                  },
                  {
                    "name": "GITHUB_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "token",
                        "name": "api-build-1-git"
                      }
                    }
                  }
                ],
                "image": "alpine/git:latest",
                "name": "git",
                "resources": {},
                "volumeMounts": [
                  {
                    "mountPath": "/workspace",
                    "name": "workspace"
                  }
                ]
              }
            ],
            "restartPolicy": "Never",
            "volumes": [
              {
                "emptyDir": {},
                "name": "workspace"
              },
              {
                "name": "registry-auth",
                "secret": {
                  "items": [
                    {
                      "key": ".dockerconfigjson",
                      "path": "config.json"
                    }
                  ],
                  "secretName": "api-build-1-registry"
                }
              }
            ]
          }
        },
        "ttlSecondsAfterFinished": 3600
      }
    }
