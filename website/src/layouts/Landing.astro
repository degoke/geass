---
import "../styles/fonts.css";
import "../styles/landing.css";
import favicon from "../assets/favicon.svg";
import og from "../assets/og.png";
import dashboard from "../assets/dashboard.webp";
import dashboardLight from "../assets/dashboard-light.webp";
import grotesk from "../assets/fonts/space-grotesk-latin-wght-normal.woff2?url";
import { absoluteUrl, docsUrl, jsonLd, licenseUrl, siteName, socialTags, withBase } from "../lib/site";

interface Props {
  /** The search-result title: say what Geass is. */
  title: string;
  description: string;
  /** The link-preview title and description (Open Graph, X). These can be more brand-led than the search ones. */
  shareTitle: string;
  shareDescription: string;
}

const { title, description, shareTitle, shareDescription } = Astro.props;

// Link scrapers and search engines ignore relative URLs, so these are absolute whenever the build knows its address.
const site = Astro.site;
const abs = (path: string) => (site ? absoluteUrl(path, site) : path);
const canonical = abs(Astro.url.pathname);
const ogImage = abs(og.src);
const home = abs(withBase("/"));

// Structured data: the site, and the product it describes. No offers, ratings or organisation are claimed.
// `downloadUrl` and `sameAs` (the GitHub releases and repository) are left out while that repository is private and
// has no release: they would point search engines at 404s. Add them back once it is public and tagged.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: siteName,
      url: home,
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${home}#software`,
      name: siteName,
      url: home,
      description,
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Self-hosted cloud platform",
      operatingSystem: "Linux",
      license: licenseUrl,
      softwareHelp: { "@type": "WebSite", url: abs(docsUrl) },
      image: ogImage,
      isPartOf: { "@id": `${home}#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline define:vars={{ heroLight: dashboardLight.src, heroDark: dashboard.src }}>
      // The reader's own choice if there is one (the docs theme picker saves "light" or "dark" under Starlight's key,
      // and "auto" as an empty string), otherwise the system's theme, and light when the system has none.
      // It also keeps the theme-color meta on that theme, and preloads only the hero screenshot that theme shows (both
      // screenshots are lazy, so the other one is never fetched).
      (function () {
        var query = matchMedia("(prefers-color-scheme: dark)");
        var meta = document.querySelector('meta[name="theme-color"]');
        function apply() {
          var stored = null;
          try {
            stored = localStorage.getItem("starlight-theme");
          } catch (e) {}
          var theme = stored === "light" || stored === "dark" ? stored : query.matches ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#ffffff");
          return theme;
        }
        var hero = document.createElement("link");
        hero.rel = "preload";
        hero.as = "image";
        hero.fetchPriority = "high";
        hero.href = apply() === "dark" ? heroDark : heroLight;
        document.head.appendChild(hero);
        query.addEventListener("change", apply);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="sitemap" type="application/xml" href={withBase("sitemap-index.xml")} />
    <link rel="preload" href={grotesk} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {socialTags({ title: shareTitle, description: shareDescription, image: ogImage }).map((attrs) => <meta {...attrs} />)}

    <script type="application/ld+json" set:html={jsonLd(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
