---
import { withBase } from "../../lib/site";

// Each tile ends with links into the docs, so the page leads to the detail behind every claim.
const doc = (slug: string) => withBase(`docs/${slug}/`);
---
  <section class="sec sec-black" id="features" aria-labelledby="features-title">
    <div class="sec-inner">
      <div class="sec-head">
        <span class="eyebrow mono">WHAT YOU GET</span>
        <h2 id="features-title">A managed cloud, on servers you own</h2>
        <p class="sub">Everything you would expect from a cloud platform, running on your own VPS and bare-metal machines.</p>
      </div>

      <div class="bento">
        <article class="tile">
          <span class="eyebrow mono">SHIP</span>
          <h3>Push and it ships</h3>
          <p>Deploy from GitHub or any container image. Every pull request gets its own preview.</p>
          <div class="viz" aria-hidden="true">
            <div class="pipe"><span class="st ok">push main</span><i></i><span class="st ok">build</span><i></i><span class="st ok">live 3/3</span></div>
            <div class="pipe"><span class="st">pr-482</span><i></i><span class="st ring">preview</span></div>
          </div>
          <ul class="chips"><li>Functions</li><li>Templates</li><li>Your own domain</li><li>Object storage</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("guides/apps")}>Apps</a>
            <a href={doc("guides/github-and-builds")}>GitHub and builds</a>
            <a href={doc("guides/pull-request-environments")}>Pull-request environments</a>
          </div>
        </article>

        <article class="tile">
          <span class="eyebrow mono">DATA</span>
          <h3>Databases that look after themselves</h3>
          <p>Postgres, MySQL, Redis and SQLite on your own servers, with backups and restore built in.</p>
          <div class="viz" aria-hidden="true">
            <div class="engines"><span>Postgres</span><span>MySQL</span><span>Redis</span><span>SQLite</span></div>
            <div class="tl"><b style="left: 68%"></b><em style="left: 68%">restore to 14:32</em></div>
          </div>
          <ul class="chips"><li>Point-in-time restore</li><li>Shared servers</li><li>7-day undelete</li><li>SQL console</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("guides/databases")}>Databases</a>
            <a href={doc("guides/backups-and-restore")}>Backups and restore</a>
            <a href={doc("guides/shared-database-servers")}>Shared servers</a>
          </div>
        </article>

        <article class="tile">
          <span class="eyebrow mono">SCALE</span>
          <h3>From one server to a fleet</h3>
          <p>Join another VPS or bare-metal machine and your work spreads across it. Or let Geass create machines at a cloud when pods cannot start, up to a cap you set.</p>
          <div class="viz" aria-hidden="true">
            <div class="nodes">
              <span class="node"><b><i class="dot"></i>node-1</b><small>eu</small></span>
              <span class="node"><b><i class="dot"></i>node-2</b><small>eu</small></span>
              <span class="node"><b><i class="dot"></i>node-3</b><small>us</small></span>
              <span class="node ghost">+ join</span>
            </div>
          </div>
          <ul class="chips"><li>Regions and tags</li><li>Node pools (experimental)</li><li>HA Postgres</li><li>Replicated volumes</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("getting-started/add-servers")}>Add servers</a>
            <a href={doc("guides/node-pools")}>Node pools</a>
            <a href={doc("guides/scaling-and-placement")}>Scaling and placement</a>
            <a href={doc("operations/high-availability")}>High availability</a>
          </div>
        </article>

        <article class="tile">
          <span class="eyebrow mono">REVIEW</span>
          <h3>See the diff, then deploy</h3>
          <p>Edits wait as drafts. Review exactly what changes, then ship it all at once.</p>
          <div class="viz" aria-hidden="true">
            <div class="diff"><span>web</span><span>replicas <s>2</s> &rarr; 3</span></div>
            <div class="diff"><span>orders-db</span><span>storage <s>20</s> &rarr; 40 GiB</span></div>
            <span class="mini-btn">Deploy 2 changes</span>
          </div>
          <ul class="chips"><li>Instant live settings</li><li>Capacity checks</li><li>Deploy history</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("guides/projects-and-environments")}>Projects and environments</a>
            <a href={doc("overview/concepts")}>Core concepts</a>
          </div>
        </article>

        <article class="tile">
          <span class="eyebrow mono">OBSERVE</span>
          <h3>See what it is doing</h3>
          <p>Live logs, metrics, a shell and a SQL console, right in the browser.</p>
          <div class="viz" aria-hidden="true">
            <div class="obs">
              <div class="bars"><i style="height: 35%"></i><i style="height: 55%"></i><i style="height: 42%"></i><i style="height: 70%"></i><i style="height: 48%"></i><i style="height: 62%"></i><i style="height: 38%"></i><i style="height: 80%"></i></div>
              <div class="log"><span>14:31:07</span> web GET /cart 200<br /><span>14:31:08</span> thumbnails resize 4096px<br /><span class="bad">14:31:09</span> <span class="bad">thumbnails out of memory</span></div>
            </div>
          </div>
          <ul class="chips"><li>Live logs</li><li>CPU, memory, network</li><li>Terminal</li><li>Signed webhooks</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("guides/observability")}>Observability</a>
            <a href={doc("guides/usage-and-capacity")}>Usage and capacity</a>
          </div>
        </article>

        <article class="tile">
          <span class="eyebrow mono">OWN</span>
          <h3>Yours to keep</h3>
          <p>Self-hosted on your own hardware, with no telemetry and no lock-in.</p>
          <div class="viz" aria-hidden="true">
            <div class="own"><span>servers</span><b>yours</b></div>
            <div class="own"><span>data</span><b>yours</b></div>
            <div class="own"><span>backups</span><b>your bucket</b></div>
            <div class="own"><span>telemetry</span><b>none</b></div>
          </div>
          <ul class="chips"><li>Private by default</li><li>Admin and viewer roles</li><li>Open source</li><li>Standard Kubernetes</li></ul>
          <div class="tile-docs">
            <span>Docs</span>
            <a href={doc("operations/security")}>Security</a>
            <a href={doc("guides/users-and-tokens")}>Users and tokens</a>
            <a href={doc("guides/network-isolation")}>Network isolation</a>
          </div>
        </article>
      </div>
    </div>
  </section>
